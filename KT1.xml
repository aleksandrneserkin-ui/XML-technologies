<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE timeTable [
  <!ELEMENT timeTable (complexes, lessons)>
  <!ELEMENT lessons (lesson+)>
  <!ELEMENT complexes (complex+)>
  <!ELEMENT lesson (date, time)>
  <!ELEMENT complex (name, address)>
  <!ATTLIST complex code ID #REQUIRED>
   <!ATTLIST lesson no CDATA #REQUIRED
   complex IDREF #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT address (#PCDATA)>  
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
]>

<timeTable>
  <complexes>
    <complex code="c1">
      <name></name>
      <address></address>
    </complex>
    <complex code="c2">
      <name></name>
      <address></address>
    </complex>
  </complexes>
  <lessons>
    <lesson no="1" complex="c1">
      <date>25-08-2026</date>
      <time>10:00</time>
    </lesson>
    <lesson no="2" complex="c2">
      <date>28-09-2026</date>
      <time>12:30</time>
    </lesson>
  </lessons>
</timeTable>